<!doctype html>
<html lang="en-BW" data-env="{{ noindex ? 'local' : 'production' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# Default blocks, defined but not printed here; pages override them. #}
  {% if false %}{% block description %}A 100% citizen-owned civil, mechanical and electrical engineering contractor in Gaborone, serving Botswana's mines, utilities and ministries since 2007.{% endblock %}{% block robots %}{% endblock %}{% endif %}
  {# Titles keep the brand suffix while they fit in about 60 characters; long project names stand alone. #}
  {% set base_title = block('title') is defined ? block('title')|trim : '' %}
  {% set page_title = base_title == '' ? 'Evolution Engineers / Engineering Contractor in Botswana' : ((base_title ~ ' / Evolution Engineers')|length <= 60 ? base_title ~ ' / Evolution Engineers' : base_title) %}
  {% set page_description = block('description')|excerpt(158) %}
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% elseif block('robots') is defined and block('robots')|trim %}<meta name="robots" content="{{ block('robots')|trim }}">{% endif %}
  <meta name="theme-color" content="#0B1930">
  <meta name="color-scheme" content="light">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Evolution Engineers">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:locale" content="en_BW">
  <meta property="og:image" content="{{ base_url }}/images/og-default.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Evolution Engineers: civil, mechanical and electrical engineering contractor in Gaborone, Botswana">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description }}">
  <meta name="twitter:image" content="{{ base_url }}/images/og-default.png">

  {{ vite_preload_fonts('resources/js/main.js', ['roboto-latin-900', 'barlow-latin-400']) }}
  {% if vite_dev() %}
    {{ vite_css('resources/js/main.js') }}
  {% else %}
    <style nonce="{{ csp_nonce }}">{{ vite_inline_css('resources/js/main.js') }}</style>
  {% endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <script type="application/ld+json" nonce="{{ csp_nonce }}">
  {{ {
    '@context': 'https://schema.org',
    '@type': ['Organization', 'GeneralContractor'],
    'name': 'Evolution Engineers',
    'url': base_url ~ '/',
    'foundingDate': '2007-05',
    'telephone': '+267 392 3065',
    'email': 'info@evolutionengineers.co.bw',
    'logo': base_url ~ '/images/brand/logo.png',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': 'Plot 61047, Block 8 Industrial',
      'addressLocality': 'Gaborone',
      'addressCountry': 'BW'
    },
    'areaServed': { '@type': 'Country', 'name': 'Botswana' }
  }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
  </script>
  {% block head %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
  {% block skip %}<a class="skip-link" href="#main">Skip to content</a>{% endblock %}
  {% include 'partials/header.twig' %}

  <main id="main" tabindex="-1">
    {% block content %}{% endblock %}
  </main>

  {% block cta %}{% endblock %}
  {% include 'partials/footer.twig' %}

  {{ vite_js('resources/js/main.js', csp_nonce) }}
  {% block scripts %}{% endblock %}
</body>
</html>
