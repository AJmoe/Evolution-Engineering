{% extends 'layout.twig' %}
{% import 'components/macros.twig' as ui %}
{% set crumbs = [{ label: 'Projects', href: '/projects' }, { label: project.title, href: '/projects/' ~ project.slug }] %}

{% block title %}{{ project.title }}{% endblock %}
{% block description %}{{ project.summary|length > 150 ? project.summary|slice(0, 147) ~ '...' : project.summary ~ ' For ' ~ project.client_name ~ '.' }}{% endblock %}
{% block head %}
  {{ ui.breadcrumb_jsonld(crumbs, base_url, csp_nonce) }}
  <script type="application/ld+json" nonce="{{ csp_nonce }}">{{ {
    '@context': 'https://schema.org',
    '@type': 'Article',
    'headline': project.title,
    'description': project.summary,
    'about': project.category_label,
    'author': { '@type': 'Organization', 'name': 'Evolution Engineers' },
    'mainEntityOfPage': canonical
  }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block content %}
  {% import 'components/icons.twig' as ic %}
  {{ ui.page_header(project.title, null, crumbs) }}

  <section class="bx-section" aria-labelledby="overview-heading">
    <div class="container project-bx">
      <div>
        <h2 id="overview-heading">Project Description</h2>
        <p>{{ project.summary }}</p>
        {% if project.scope and project.scope != project.summary %}
          <h3>Scope Of Works</h3>
          <p>{{ project.scope }}</p>
        {% endif %}
        <h3>Key Facts</h3>
        <dl class="spec">
          <dt>Client</dt><dd>{{ project.client_name }}</dd>
          <dt>Type</dt><dd>{{ project.category_label }}</dd>
          <dt>Completed</dt><dd>{{ project.year_label }}</dd>
          <dt>Our role</dt><dd>{{ project.role_label }}</dd>
          {% for label, value in project.key_facts %}<dt>{{ label }}</dt><dd>{{ value }}</dd>{% endfor %}
          {% if project.value_pula %}<dt>Contract value</dt><dd>P {{ project.value_pula|number_format(2, '.', ',') }}</dd>{% endif %}
        </dl>
        <p class="sidebar-cta"><a class="btn btn--red" href="/contact">Discuss a similar project {{ ic.icon('arrow-circle') }}</a></p>
      </div>
      <div class="project-bx__photos">
        <figure>
          <div class="split-bx__media">{{ ui.project_media(project, '(min-width: 900px) 50vw, 100vw', true) }}</div>
          {% if project.photo_key %}<figcaption class="small muted">Illustrative photo of similar work. Photography of this project will follow.</figcaption>{% endif %}
        </figure>
      </div>
    </div>
  </section>

  {% if related %}
    <section class="bx-section bx-section--soft" aria-labelledby="related-heading">
      <div class="container">
        <div class="sec-title sec-title--split">
          <div>
            <p class="eyebrow">{{ project.category_label }}</p>
            <h2 id="related-heading">Related Projects</h2>
          </div>
          <a class="btn btn--red" href="/projects?type={{ project.category }}">View all {{ ic.icon('arrow-circle') }}</a>
        </div>
        <div class="tiles-grid">{% for p in related %}{{ ui.project_tile(p) }}{% endfor %}</div>
      </div>
    </section>
  {% endif %}
{% endblock %}
