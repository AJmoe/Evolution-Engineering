{% extends 'layout.twig' %}
{% import 'components/macros.twig' as ui %}
{% import 'components/icons.twig' as ic %}

{% block title %}Page not found{% endblock %}
{% block description %}The page you asked for is not on the Evolution Engineers website. Use the links on this page to find our services, projects and contact details.{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block content %}
  {{ ui.page_header('Page Not Found', 'It may have moved, or the address may have a typing mistake. These pages are a good place to start.', []) }}
  <section class="bx-section">
    <div class="container">
      <ul class="svc-grid">
        {% for l in [
          { href: '/services', name: "Our\nServices", icon: 'civil' },
          { href: '/projects', name: "Our\nProjects", icon: 'projects' },
          { href: '/small-homes', name: "Small\nHomes", icon: 'building' },
          { href: '/contact', name: "Contact\nUs", icon: 'team' },
        ] %}
          <li><a class="svc-card" href="{{ l.href }}">{{ ic.picto(l.icon, 'svc-icon') }}<h3>{{ l.name }}</h3></a></li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endblock %}
