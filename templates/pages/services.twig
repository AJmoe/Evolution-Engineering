{% extends 'layout.twig' %}
{% import 'components/macros.twig' as ui %}
{% import 'components/icons.twig' as ic %}
{% set crumbs = [{ label: 'Services', href: '/services' }] %}

{% block title %}Services{% endblock %}
{% block description %}Civil, mechanical and electrical engineering, plus valves, pipes and motors, from one Gaborone contractor with its own workshop and plant.{% endblock %}
{% block head %}{{ ui.breadcrumb_jsonld(crumbs, base_url, csp_nonce) }}{% endblock %}

{% block content %}
  {{ ui.page_header('Our Services', null, crumbs) }}

  <section class="bx-section" aria-labelledby="services-heading">
    <div class="container">
      <div class="sec-title">
        <p class="eyebrow">What we do</p>
        <h2 id="services-heading">Our Services That We Provide</h2>
        <p>Three engineering disciplines and a supplies business, run from our head office and fabrication workshop at Block 8 Industrial, Gaborone, with our own plant on site.</p>
      </div>
      <ul class="svc-grid">
        {% for card in service_cards %}
          <li data-reveal>
            <a class="svc-card" href="{{ card.url }}">
              {{ ic.picto(card.icon, 'svc-icon') }}
              <h3>{{ card.name }}</h3>
              <div class="svc-card__img">{{ ui.photo(card.photo, card.photo_alt, '(min-width: 1100px) 260px, (min-width: 560px) 45vw, 100vw', false, false) }}</div>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% for s in services %}
    <section class="bx-section{% if loop.index is odd %} bx-section--soft{% endif %}" aria-labelledby="svc-{{ s.slug }}">
      <div class="container split-bx{% if loop.index is even %} split-bx--flip{% endif %}">
        <div class="split-bx__media">{{ ui.photo(s.photo, s.photo_alt, '(min-width: 900px) 50vw, 100vw', false, true) }}</div>
        <div>
          <p class="eyebrow">{{ s.name }}</p>
          <h2 id="svc-{{ s.slug }}">{{ {'civil-engineering': 'Roads, Water, Sewerage And Buildings', 'mechanical-engineering': 'Pumps, Motors, Steel And Pipework', 'electrical-engineering': 'Electrical Installations'}[s.slug] ?? s.name }}</h2>
          <ul class="ticks">
            {% for item in s.scope %}<li>{{ ic.icon('tick') }}{{ item }}</li>{% endfor %}
          </ul>
          <p>{{ s.clients }}</p>
          <p class="sidebar-cta"><a class="btn btn--red" href="{{ s.url }}">Read more {{ ic.icon('arrow-circle') }}</a></p>
        </div>
      </div>
    </section>
  {% endfor %}

  <section class="bx-section bx-section--soft" aria-labelledby="svc-supplies">
    <div class="container split-bx">
      <div class="split-bx__media">{{ ui.photo('gate-valve', 'A large industrial gate valve', '(min-width: 900px) 50vw, 100vw', false, true) }}</div>
      <div>
        <p class="eyebrow">Supplies</p>
        <h2 id="svc-supplies">Valves, Pipes And Electric Motors</h2>
        <ul class="ticks">
          {% for key, g in supplies %}
            <li>{{ ic.icon('tick') }}<span><strong>{{ g.label }}:</strong> {% for i in g.items|slice(0, 5) %}{{ i.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% if g.items|length > 5 %} and more{% endif %}</span></li>
          {% endfor %}
        </ul>
        <p>Request a price for any product group. We quote for each order.</p>
        <p class="sidebar-cta"><a class="btn btn--red" href="/supplies">See the catalogue {{ ic.icon('arrow-circle') }}</a></p>
      </div>
    </div>
  </section>
{% endblock %}

{% block cta %}{% include 'partials/feature-band.twig' %}{% endblock %}
