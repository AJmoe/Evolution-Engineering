{% extends 'layout.twig' %}
{% import 'components/macros.twig' as ui %}
{% import 'components/icons.twig' as ic %}
{% set crumbs = [{ label: 'About', href: '/about' }] %}

{% block title %}About and compliance{% endblock %}
{% block description %}Evolution Engineers is a 100% citizen-owned engineering contractor established in Gaborone in May 2007, registered with PPADB in five disciplines and tax cleared.{% endblock %}
{% block head %}{{ ui.breadcrumb_jsonld(crumbs, base_url, csp_nonce) }}{% endblock %}

{% block content %}
  {{ ui.page_header('About Us', null, crumbs) }}

  {# Company story with stacked photos and a years badge #}
  <section class="bx-section" aria-labelledby="story-heading">
    <div class="container about-bx__grid">
      <div class="about-bx__media about-bx__media--stack" data-reveal>
        {{ ui.photo('roller', 'A road roller compacting soil', '(min-width: 1000px) 400px, 100vw', false, true) }}
        <div class="inset">{{ ui.photo('cutting-torch', 'Steel being cut in a fabrication workshop', '240px', false, false) }}</div>
        <p class="years-badge"><strong>{{ stats.years }}</strong><span>Years<br>Experience</span></p>
      </div>
      <div class="about-bx__body">
        <p class="eyebrow">About company</p>
        <h2 id="story-heading">A Botswana Contractor Since May 2007</h2>
        <p class="lede">Evolution Engineers is a 100% citizen-owned company specialising in civil, mechanical and electrical engineering works.</p>
        <p>We are seasoned with engineers and artisans who have vast experience in the mining sector. Our clientele includes Debswana, particularly the Jwaneng and Orapa mines, Karowe Diamond Mine, Tati Nickel Mining Company, government ministries, councils and the private sector. Our head office and workshop for fabrication are in Gaborone at Plot 61047, Block 8 Industrial. The premises have been extensively renovated to provide an enhanced working environment for technical and administrative staff.</p>
      </div>
    </div>
  </section>

  {# Why choose us, with bars computed from the project records #}
  <section class="bx-section bx-section--soft" aria-labelledby="why-heading">
    <div class="container split-bx">
      <div>
        <p class="eyebrow">Our key points</p>
        <h2 id="why-heading">Why Choose Us</h2>
        <p>Mines, utilities, ministries and councils have trusted us with roads, pipelines, sewer networks, buildings and plant works across Botswana.</p>
        <ul class="ticks">
          <li>{{ ic.icon('tick') }}100% citizen owned, established in May 2007</li>
          <li>{{ ic.icon('tick') }}Registered with PPADB in five disciplines</li>
          <li>{{ ic.icon('tick') }}Registered for VAT and tax cleared</li>
          <li>{{ ic.icon('tick') }}Our own fabrication workshop and plant fleet</li>
        </ul>
        <div class="bars">
          {% set share = stats.projects ? (stats.main_contractor / stats.projects * 100)|round : 0 %}
          <div class="bar" data-to="{{ share }}">
            <p class="bar__label"><span>Projects delivered as main contractor</span><span>{{ share }}%</span></p>
            <div class="bar__track"><span class="bar__fill"></span></div>
          </div>
        </div>
      </div>
      <div class="split-bx__media" data-reveal>{{ ui.photo('steel-frame', 'The steel frame of a building under construction', '(min-width: 900px) 50vw, 100vw', false, true) }}</div>
    </div>
  </section>

  {# Mission and vision, from the company profile #}
  <section class="bx-section" aria-labelledby="mission-heading">
    <div class="container split-bx split-bx--top">
      <div>
        <p class="eyebrow">Our mission</p>
        <h2 id="mission-heading">Partnership From Start To Finish</h2>
        <p>Evolution Engineers is a leader in providing value-added construction services to our customers by creating a successful partnership with them throughout the construction process.</p>
      </div>
      <div>
        <p class="eyebrow">Our vision</p>
        <h2>Lasting Relationships And Superior Value</h2>
        <p>To establish lasting relationships with our customers by exceeding their expectations, and to create a competitive advantage through products and services which provide superior value.</p>
      </div>
    </div>
  </section>

  {# Statistics #}
  <section class="bx-section bx-section--soft" aria-labelledby="stats-heading">
    <div class="container stats-bx__grid">
      <div>
        <p class="eyebrow">Statistics</p>
        <h2 id="stats-heading">Know More About Our Record</h2>
        <p class="muted">Figures from our own project records and registrations.</p>
      </div>
      <ul class="stat-cards">
        <li class="stat-card">{{ ic.picto('projects') }}<div><strong data-count="{{ stats.projects }}">{{ stats.projects }}</strong><span>Projects listed</span></div></li>
        <li class="stat-card">{{ ic.picto('building') }}<div><strong data-count="{{ stats.main_contractor }}">{{ stats.main_contractor }}</strong><span>As main contractor</span></div></li>
        <li class="stat-card">{{ ic.picto('calendar') }}<div><strong data-count="{{ stats.years }}">{{ stats.years }}</strong><span>Years in business</span></div></li>
        <li class="stat-card">{{ ic.picto('certificate') }}<div><strong data-count="{{ stats.disciplines }}">{{ stats.disciplines }}</strong><span>PPADB disciplines</span></div></li>
      </ul>
    </div>
  </section>

  {# Registrations and facilities #}
  <section class="bx-section" aria-labelledby="compliance-heading">
    <div class="container split-bx split-bx--top">
      <div>
        <p class="eyebrow">Registrations</p>
        <h2 id="compliance-heading">Registered And Tax Cleared</h2>
        <p>We are registered for various grades with the Public Procurement and Asset Disposal Board (PPADB) in the following disciplines:</p>
        <ul class="ticks" data-placeholder="TODO-CLIENT: confirm grades and registration period">
          {% for r in registrations %}<li>{{ ic.icon('tick') }}{{ r }}</li>{% endfor %}
        </ul>
        <p>We are duly registered with the tax department and tax cleared.</p>
      </div>
      <div>
        <p class="eyebrow">Facilities</p>
        <h2>Our Head Office And Workshop</h2>
        <p>The firm has operated in Botswana since 2007 from premises at Plot 61047, Block 8 Industrial, Gaborone, with a fabrication workshop on site. Our plant fleet covers earthmoving, compaction and haulage, with fully equipped off-road vehicles for field inspections and reconnaissance surveys.</p>
        <p class="sidebar-cta"><a class="btn btn--red" href="/plant-and-equipment">See our plant {{ ic.icon('arrow-circle') }}</a></p>
      </div>
    </div>
  </section>
{% endblock %}
