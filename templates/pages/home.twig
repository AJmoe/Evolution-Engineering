{% extends 'layout.twig' %}
{% import 'components/macros.twig' as ui %}
{% import 'components/icons.twig' as ic %}

{% block content %}
  {# 1. Hero: kicker, oversized half-outlined word, short statement, link #}
  <section class="bx-hero" aria-labelledby="hero-heading">
    <div class="bx-hero__bg">{{ ui.photo('building-glass', '', '100vw', true, false) }}</div>
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container">
      <p class="bx-hero__kicker" data-reveal>Evolution in</p>
      <h1 id="hero-heading" data-reveal><span>Engin</span><span class="outline">eering</span></h1>
      <p data-reveal>Civil, mechanical and electrical engineering for Botswana's mines, utilities, ministries and private clients, since 2007.</p>
      <div class="bx-hero__actions" data-reveal>
        <a class="btn btn--red" href="/contact">Request a quote</a>
        <a class="text-link" href="/projects">Discover our projects {{ ic.icon('arrow') }}</a>
      </div>
      <div class="bx-hero__badge" data-reveal>
        <strong>{{ stats.projects }}</strong>
        <span>Projects delivered<br>across Botswana</span>
      </div>
    </div>
  </section>

  {# 2. Welcome: photo with brand squares, statement, director #}
  <section class="bx-section--navy welcome" aria-labelledby="welcome-heading">
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container welcome__grid">
      <div class="welcome__media" data-reveal>
        {{ ui.photo('pipeline-trench', 'Workers laying a pipeline in a trench', '(min-width: 900px) 300px, 100vw', false, true) }}
        <div class="squares" aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
      <div class="welcome__body">
        <p class="eyebrow">Welcome to Evolution Engineers</p>
        <h2 id="welcome-heading">Engineering Contractor With Roots <span>In Botswana's Mining Sector</span></h2>
        <p class="welcome__lead">Evolution Engineers is a 100% citizen-owned company specialising in civil, mechanical and electrical engineering works, established in May 2007.</p>
        <p>We are seasoned with engineers and artisans who have vast experience in the mining sector. Our clientele includes Debswana, particularly the Jwaneng and Orapa mines, Karowe Diamond Mine, Tati Nickel Mining Company, government ministries, councils and the private sector. Our head office and fabrication workshop are in Gaborone at Plot 61047, Block 8 Industrial.</p>
        <div class="director">
          <span class="avatar" aria-hidden="true">TD</span>
          <div>
            <strong>Trinity Dialwa</strong>
            <span>Director</span>
          </div>
          <p class="director__card">Cell <a href="tel:{{ settings.cell_e164 }}">+267 {{ settings.cell }}</a><br><a href="mailto:{{ settings.email_general }}">{{ settings.email_general }}</a></p>
        </div>
      </div>
    </div>
  </section>

  {# 3. Services slider #}
  <section class="bx-section bx-section--soft" aria-labelledby="services-heading">
    <div class="container">
      <div class="sec-title" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 id="services-heading">Our Services That We Provide</h2>
        <p>Three engineering disciplines, a supplies business and our own plant, run from our head office and fabrication workshop at Block 8 Industrial, Gaborone. Call or write and one of our engineers will answer your questions and arrange a site visit.</p>
      </div>
      <div class="slider" data-slider>
        <ul class="slider__track" aria-label="Services">
          {% for card in service_cards %}
            <li>
              <a class="svc-card" href="{{ card.url }}">
                {{ ic.picto(card.icon, 'svc-icon') }}
                <h3>{{ card.name }}</h3>
                <div class="svc-card__img">{{ ui.photo(card.photo, card.photo_alt, '(min-width: 1100px) 260px, (min-width: 640px) 45vw, 86vw', false, false) }}</div>
              </a>
            </li>
          {% endfor %}
        </ul>
        <div class="slider__nav">
          <button class="round-btn" type="button" data-prev aria-label="Previous services">{{ ic.icon('chev-left') }}</button>
          <button class="round-btn" type="button" data-next aria-label="Next services">{{ ic.icon('chev-right') }}</button>
        </div>
      </div>
    </div>
  </section>

  {# 4. Why choose us: real facts only. Bars are computed from the project records. #}
  <section class="why-bx" aria-labelledby="why-heading">
    <div class="why-bx__bg">{{ ui.photo('water-tower', '', '100vw', false, false) }}</div>
    <div class="why-bx__grid">
      <div class="why-bx__card" data-reveal>
        <p class="eyebrow">Our key points</p>
        <h2 id="why-heading">Why Choose Us</h2>
        <p>Procurement teams at mines, utilities and ministries shortlist us because we have delivered for them since 2007, with our own engineers, our own workshop and our own plant.</p>
        <ul class="ticks">
          <li>{{ ic.icon('tick') }}100% citizen owned, established in May 2007</li>
          <li>{{ ic.icon('tick') }}Registered with PPADB in five disciplines</li>
          <li>{{ ic.icon('tick') }}Engineers and artisans from the mining sector</li>
          <li>{{ ic.icon('tick') }}Our own fabrication workshop and plant fleet</li>
        </ul>
        <div class="bars">
          <div class="bar" data-to="{{ stats.main_share }}">
            <p class="bar__label"><span>Projects delivered as main contractor</span><span>{{ stats.main_share }}%</span></p>
            <div class="bar__track"><span class="bar__fill"></span></div>
          </div>
          {% for p in stats.in_progress|slice(0, 1) %}
            {% set pct = p.year_label|split('%')|first|split(' ')|last %}
            {% if pct matches '/^\\d+$/' %}
              <div class="bar" data-to="{{ pct }}">
                <p class="bar__label"><span>{{ p.title }}</span><span>{{ pct }}%</span></p>
                <div class="bar__track"><span class="bar__fill"></span></div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="call-row">
          <div class="call-row__icon" aria-hidden="true"><span>{{ ic.icon('phone') }}</span></div>
          <div>
            <small>Call the office now</small>
            <a href="tel:{{ settings.phone_e164 }}">+267 {{ settings.phone }}</a>
          </div>
        </div>
      </div>
      <div class="why-bx__side">
        <div class="why-bx__photo">{{ ui.photo('pipeline-forest', 'A large pipeline under construction through forest', '(min-width: 1000px) 600px, 100vw', false, true) }}</div>
        <div class="feature-box" data-reveal>
          <div class="feature-box__badge" aria-hidden="true"><span>{{ ic.icon('gear') }}</span></div>
          <p class="eyebrow">Mines, utilities, ministries</p>
          <h2>Trusted On Botswana's Biggest Pipelines</h2>
          <p>Including the design and construction of the approximately 100 km transmission pipeline from Masama Wellfield to the Mmamashia Water Treatment Plant.</p>
          <a class="text-link" href="/contact">Request a call back {{ ic.icon('arrow') }}</a>
        </div>
      </div>
    </div>
  </section>

  {# 5. Recent projects on navy, tiles hanging into the white below, then outlined type #}
  <section class="work" aria-labelledby="work-heading">
    <div class="container">
      <div class="sec-title sec-title--split sec-title--light" data-reveal>
        <div>
          <p class="eyebrow">Our work</p>
          <h2 id="work-heading">Explore Recent Projects</h2>
        </div>
        <a class="btn btn--red" href="/projects">View all projects {{ ic.icon('arrow-circle') }}</a>
      </div>
    </div>
    <ul class="tiles-row">
      {% for p in tiles %}
        <li class="tile" data-reveal>
          {{ ui.project_media(p, '(min-width: 1100px) 25vw, (min-width: 560px) 50vw, 100vw', false) }}
          <div class="tile__overlay">
            <p>{{ p.category_label }}</p>
            <h3><a href="/projects/{{ p.slug }}">{{ p.title }}</a></h3>
          </div>
        </li>
      {% endfor %}
    </ul>
  </section>
  <div class="outline-type" aria-hidden="true">
    <span class="outline-type__run"><span>Civil Mechanical Electrical Engineering</span><span>Civil Mechanical Electrical Engineering</span></span>
  </div>

  {# 6. About: photo, statement, two features #}
  <section class="about-bx" aria-labelledby="about-heading">
    <div class="container about-bx__grid">
      <div class="about-bx__media" data-reveal>
        {{ ui.photo('roller', 'A road roller compacting soil', '(min-width: 1000px) 400px, 100vw', false, true) }}
      </div>
      <div class="about-bx__body">
        <p class="eyebrow">About company</p>
        <h2 id="about-heading">We Provide Value-Added Construction Services</h2>
        <p>Evolution Engineers is a leader in providing value-added construction services to our customers by creating a successful partnership with them throughout the construction process. Our pledge is to establish lasting relationships with our customers by exceeding their expectations and gaining their trust through exceptional performance by every member of the construction team.</p>
        <div class="feats">
          <div class="feat" data-reveal>
            <div class="feat__head">{{ ic.picto('team') }}<h3>Seasoned{{ "\n" }}Team</h3></div>
            <p>Engineers and artisans with vast experience in the mining sector.</p>
          </div>
          <div class="feat" data-reveal>
            <div class="feat__head">{{ ic.picto('plant') }}<h3>Own Plant{{ "\n" }}&amp; Workshop</h3></div>
            <p>Excavators, loaders, rollers and trucks, and a fabrication workshop in Gaborone.</p>
          </div>
        </div>
        <p><a class="text-link" href="/about">More about us {{ ic.icon('arrow') }}</a></p>
      </div>
    </div>
  </section>

  {# 7. Statement cards on navy (the theme's testimonial band). Taken from the company profile, not invented quotes. #}
  <section class="voices on-dark" aria-labelledby="voices-heading">
    {{ ic.blueprint_art() }}
    <div class="container voices__grid">
      <div class="sec-title sec-title--light" data-reveal>
        <p class="eyebrow">Mission and vision</p>
        <h2 id="voices-heading">What Drives Our Company?</h2>
      </div>
      <div class="slider slider--2" data-slider>
        <ul class="slider__track" aria-label="Mission and vision">
          {% for q in [
            { text: 'To be a leader in providing value-added construction services, by creating a successful partnership with our customers throughout the construction process.', who: 'Our Mission', role: 'Company profile' },
            { text: 'To establish lasting relationships with our customers by exceeding their expectations and gaining their trust through exceptional performance by every member of the construction team.', who: 'Our Pledge', role: 'Company profile' },
            { text: 'To create a competitive advantage by purchasing and distributing products and services which provide superior value to our customers.', who: 'Our Vision', role: 'Company profile' },
          ] %}
            <li class="quote-card">
              <div class="quote-card__body">
                {{ ic.icon('quote') }}
                <p>{{ q.text }}</p>
              </div>
              <div class="quote-card__who">
                <span class="avatar" aria-hidden="true">EE</span>
                <div><strong>{{ q.who }}</strong><span>{{ q.role }}</span></div>
              </div>
            </li>
          {% endfor %}
        </ul>
        <div class="slider__nav slider__nav--left">
          <button class="round-btn" type="button" data-prev aria-label="Previous statement">{{ ic.icon('arrow-left') }}</button>
          <button class="round-btn" type="button" data-next aria-label="Next statement">{{ ic.icon('arrow') }}</button>
        </div>
      </div>
    </div>
  </section>

  {# 8. Latest milestones (the theme's news section), from dated project records #}
  <section class="bx-section" aria-labelledby="news-heading">
    <div class="container">
      <div class="sec-title sec-title--split" data-reveal>
        <div>
          <p class="eyebrow">From our records</p>
          <h2 id="news-heading">Latest Milestones</h2>
        </div>
        <p>Recently completed contracts for Botswana's mines, utilities and government. Every project page lists the client, scope and our role.</p>
      </div>
      <ul class="posts">
        {% for p in recent %}
          {% set parts = p.year_label|split(' ') %}
          <li class="post" data-reveal>
            <div class="post__media">{{ ui.project_media(p, '(min-width: 1000px) 370px, 100vw', false) }}</div>
            <div class="post__body">
              <p class="date-badge" aria-label="Completed {{ p.year_label }}">
                {% if parts|length > 1 %}<strong>{{ parts|first }}</strong><span>{{ parts|last }}</span>{% else %}<strong>{{ p.year }}</strong>{% endif %}
              </p>
              <p class="post__meta">{{ p.client_name|split(' (')|first }} / {{ p.role_label }}</p>
              <h3><a href="/projects/{{ p.slug }}">{{ p.title }}</a></h3>
              <a class="pill-link" href="/projects/{{ p.slug }}" aria-label="Read more about {{ p.title }}">Read more</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# 9. Clients, as names (logos need each client's permission) #}
  <section class="clients" aria-labelledby="clients-heading">
    <div class="container">
      <h2 id="clients-heading" class="clients__title">We have worked with</h2>
      <ul>
        <li>Debswana<small>Jwaneng &amp; Orapa</small></li>
        <li>Water Utilities<small>Corporation</small></li>
        <li>Morupule<small>Coal Mine</small></li>
        <li>BDC<small>Botswana Development Corp.</small></li>
        <li>BURS<small>Unified Revenue Service</small></li>
        <li>BPC<small>Power Corporation</small></li>
      </ul>
    </div>
  </section>

  {# 10. Map with office address box #}
  {% include 'partials/map.twig' %}
{% endblock %}
