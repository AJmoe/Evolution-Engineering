<section class="cta-band section" aria-labelledby="cta-heading">
  <div class="container cta-band__inner">
    <div class="stack">
      <h2 id="cta-heading">Send us the drawings.</h2>
      <p class="lede">Tell us what you are planning. We will reply with a price, a programme, or the questions we need answered first.</p>
    </div>
    <div class="cta-band__contact">
      <div><a class="btn btn--primary" href="/contact">Request a quote</a></div>
      <p>Phone <a href="tel:{{ settings.phone_e164 }}">{{ settings.phone }}</a></p>
      <p>Tenders <a href="mailto:{{ settings.email_tenders }}"{% if settings.emails_are_placeholders %} data-placeholder{% endif %}>{{ settings.email_tenders }}</a></p>
    </div>
  </div>
</section>
