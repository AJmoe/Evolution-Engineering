{% import 'components/macros.twig' as ui %}
{% set nav = [
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/small-homes', label: 'Small homes' },
  { href: '/plant-and-equipment', label: 'Plant' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
] %}
<header class="site-header">
  <div class="container">
    <nav class="nav-pill" aria-label="Main">
      {{ ui.brand() }}
      <ul class="nav-links">
        {% for item in nav %}
          <li><a href="{{ item.href }}"{% if section == item.href or (item.href == '/services' and section == '/supplies') %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
      <a class="btn btn--primary btn--small nav-cta" href="/contact">Request a quote</a>
      <button class="menu-toggle" type="button" data-menu-open aria-expanded="false" aria-controls="menu-sheet">
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.6"/></svg>
        Menu
      </button>
    </nav>
  </div>
</header>

<div class="menu-sheet" id="menu-sheet" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true" hidden>
  <div class="menu-sheet__top">
    {{ ui.brand() }}
    <button class="menu-toggle" type="button" data-menu-close>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6"/></svg>
      Close
    </button>
  </div>
  <ul>
    <li><a href="/"{% if current_path == '/' %} aria-current="page"{% endif %}>Home</a></li>
    {% for item in nav %}
      <li><a href="{{ item.href }}"{% if section == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
    {% endfor %}
  </ul>
  <a class="btn btn--primary" href="/contact">Request a quote</a>
  <p class="menu-sheet__contact small">Call <a href="tel:{{ settings.phone_e164 }}">{{ settings.phone }}</a> or <a href="tel:{{ settings.cell_e164 }}">{{ settings.cell }}</a></p>
</div>
