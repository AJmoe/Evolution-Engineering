{% import 'components/macros.twig' as ui %}
{% import 'components/icons.twig' as ic %}
<footer class="bx-footer">
  <div class="bx-footer__strip">
    <ul class="container">
      <li>{{ ic.icon('pin') }}<span>{{ settings.address_line }},<br>{{ settings.postal_address }}</span></li>
      <li>{{ ic.icon('mail') }}<span>Email us :<br><a class="big" href="mailto:{{ settings.email_general }}">{{ settings.email_general }}</a></span></li>
      <li>{{ ic.icon('phone') }}<span>Call us on :<br><a class="big" href="tel:{{ settings.phone_e164 }}">{{ settings.phone }}</a></span></li>
    </ul>
  </div>
  <div class="container">
    <div class="bx-footer__main">
      <div>
        <img src="/images/brand/logo-light.png" alt="Evolution Engineers" width="729" height="307" loading="lazy">
        <p>Contractors in civil, mechanical and electrical engineering services. 100% citizen owned, serving Botswana's mines, utilities, ministries and councils since 2007.</p>
      </div>
      <nav aria-label="Useful links">
        <h2 class="bx-footer__title">Useful Links</h2>
        <ul class="bx-footer__links">
          <li><a href="/about">About Us</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/plant-and-equipment">Plant &amp; Equipment</a></li>
          <li><a href="/small-homes">Small Homes</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <nav aria-label="Our services">
        <h2 class="bx-footer__title">Our Services</h2>
        <ul class="bx-footer__links">
          <li><a href="/services/civil-engineering">Civil Engineering</a></li>
          <li><a href="/services/mechanical-engineering">Mechanical Engineering</a></li>
          <li><a href="/services/electrical-engineering">Electrical Engineering</a></li>
          <li><a href="/supplies">Valves, Pipes &amp; Motors</a></li>
          <li><a href="/projects?type=roads">Roads Works</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="bx-footer__title">Request A Call Back</h2>
        <p>Leave your email and we will get back to you about your project.</p>
        <form class="callback" action="/contact" method="get">
          <label class="visually-hidden" for="callback-email">Your email address</label>
          <input id="callback-email" type="email" name="email" placeholder="Enter your email address" autocomplete="email" required>
          <button type="submit" aria-label="Continue to the enquiry form">{{ ic.icon('send') }}</button>
        </form>
        <div class="bx-footer__phones">
          <a href="tel:{{ settings.phone_e164 }}">{{ ic.icon('phone') }} {{ settings.phone }}</a>
          <a href="tel:{{ settings.cell_e164 }}">{{ ic.icon('mobile') }} {{ settings.cell }}</a>
        </div>
      </div>
    </div>
    <div class="bx-footer__bottom">
      <p>&copy; Copyright Evolution Engineers {{ year_now }}. All rights reserved.</p>
      <p><a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot; <a href="/credits">Image credits</a></p>
    </div>
  </div>
</footer>
<button class="to-top" type="button" data-to-top aria-label="Back to top">{{ ic.icon('up') }}</button>
<a class="wa-btn" href="https://wa.me/{{ settings.cell_e164|replace({'+': ''}) }}?text={{ 'Hello Evolution Engineers, I would like to ask about a project.'|url_encode }}" rel="noopener" aria-label="Chat with us on WhatsApp, {{ settings.cell }}">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 6.9L3 29l6.5-2a13.2 13.2 0 006.5 1.7c7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.8-1.6l-.4-.2-3.9 1.2 1.3-3.7-.3-.4a10.4 10.4 0 01-1.7-5.8C5.2 9.9 10 5.2 16 5.2s10.8 4.7 10.8 10.6S22 26.4 16 26.4zm5.9-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.8 8.8 0 01-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 00-.9.4 3.6 3.6 0 00-1.1 2.7 6.3 6.3 0 001.3 3.3 14.3 14.3 0 005.5 4.8c2 .9 2.8.9 3.8.8.6-.1 1.9-.8 2.2-1.5a2.6 2.6 0 00.2-1.5c-.1-.2-.3-.3-.7-.5z"/></svg>
</a>
