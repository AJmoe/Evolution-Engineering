{# Handover still, drawn as SVG until the pre-rendered 3D poster exists (phase 3). #}
<svg viewBox="0 0 760 560" aria-hidden="true" data-placeholder="hero-poster">
  <defs>
    <linearGradient id="hg-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#A9D3EE"/><stop offset=".55" stop-color="#6FAFD8"/><stop offset="1" stop-color="#3E86B8"/>
    </linearGradient>
    <linearGradient id="hg-glass-side" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#4C8DBA"/><stop offset="1" stop-color="#2F6E9C"/>
    </linearGradient>
    <linearGradient id="hg-plaza" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E9EEF2"/><stop offset="1" stop-color="#D9E1E8"/>
    </linearGradient>
    <pattern id="hg-bays" width="22" height="26" patternUnits="userSpaceOnUse">
      <rect width="22" height="26" fill="none"/>
      <path d="M0 0h22M0 0v26" stroke="#E8F1F8" stroke-width="1.4"/>
      <path d="M0 21h22" stroke="#F4F8FB" stroke-width="5" opacity=".85"/>
    </pattern>
    <pattern id="hg-bays-side" width="18" height="26" patternUnits="userSpaceOnUse">
      <path d="M0 0h18M0 0v26" stroke="#9CC2DE" stroke-width="1.2"/>
      <path d="M0 21h18" stroke="#C9DBE9" stroke-width="5" opacity=".7"/>
    </pattern>
  </defs>

  <!-- ground -->
  <path d="M0 470L380 400l380 70v90H0z" fill="url(#hg-plaza)"/>
  <path d="M60 520L380 455l320 65" fill="none" stroke="#C7D2DC" stroke-width="22"/>
  <ellipse cx="400" cy="452" rx="270" ry="26" fill="#0B2A4A" opacity=".07"/>

  <!-- 5-storey wing (left) -->
  <path d="M120 450V300l120-26v170z" fill="url(#hg-glass)"/>
  <path d="M120 450V300l120-26v170z" fill="url(#hg-bays)" opacity=".9"/>
  <path d="M120 300l120-26 40 10-120 26z" fill="#F4F8FB" stroke="#B8CAD9"/>

  <!-- 2-storey podium -->
  <path d="M220 452V384l340-30v94z" fill="#F4F8FB" stroke="#B8CAD9"/>
  <path d="M220 384l340-30" stroke="#B8CAD9"/>
  <path d="M236 446v-48l310-28v56" fill="url(#hg-glass)" opacity=".85"/>
  <path d="M236 446v-48l310-28v56" fill="url(#hg-bays)" opacity=".6"/>

  <!-- 14-storey tower -->
  <path d="M330 410V96l150-24v330z" fill="url(#hg-glass)"/>
  <path d="M330 410V96l150-24v330z" fill="url(#hg-bays)"/>
  <path d="M480 402V72l64 16v306z" fill="url(#hg-glass-side)"/>
  <path d="M480 402V72l64 16v306z" fill="url(#hg-bays-side)" opacity=".8"/>
  <path d="M330 96l150-24 64 16-150 26z" fill="#F4F8FB" stroke="#B8CAD9"/>
  <path d="M352 104l100-16" stroke="#FFFFFF" stroke-width="10" opacity=".55"/>

  <!-- entrance atrium with orange canopy -->
  <path d="M396 452v-58l84-10v64z" fill="#CFE6F7" stroke="#8FB4D0"/>
  <path d="M384 392l112-14 12 6-112 15z" fill="#F26A21"/>

  <!-- trees -->
  <g fill="#86B94F">
    <circle cx="96" cy="466" r="16"/><circle cx="150" cy="474" r="14"/><circle cx="600" cy="464" r="17"/>
    <circle cx="652" cy="474" r="14"/><circle cx="300" cy="476" r="12"/>
  </g>
  <g fill="#6E9F3D"><circle cx="102" cy="470" r="9"/><circle cx="606" cy="468" r="9"/></g>
  <!-- lamp posts -->
  <g stroke="#4A6075" stroke-width="2"><path d="M250 488v-34M540 486v-34M690 494v-30"/></g>
</svg>
