{#
  Office map with the address box. Google Maps loads only when the visitor asks for it, so the site
  keeps its no-third-party promise (see the privacy notice). Without JavaScript the button is a plain link.
#}
{% import 'components/icons.twig' as ic %}
{% set q = 'Block 8 Industrial, Gaborone, Botswana'|url_encode %}
<section class="map-bx" aria-labelledby="office-heading" data-map>
  <div class="map-bx__fallback">
    <a class="btn btn--red" href="https://www.google.com/maps/search/?api=1&amp;query={{ q }}" rel="noopener" data-map-load>{{ ic.icon('pin') }} Show map</a>
    <p class="small">Loads Google Maps</p>
  </div>
  <iframe title="Map of Block 8 Industrial, Gaborone" data-src="https://maps.google.com/maps?q={{ q }}&amp;z=14&amp;output=embed" referrerpolicy="no-referrer-when-downgrade" hidden></iframe>
  <div class="container">
    <div class="office-box">
      <h2 id="office-heading">Office Address</h2>
      <p>{{ settings.address_line }}<br>{{ settings.postal_address }}</p>
      <p>Phone : <a href="tel:{{ settings.phone_e164 }}">{{ settings.phone }}</a><br>Cell : <a href="tel:{{ settings.cell_e164 }}">{{ settings.cell }}</a></p>
    </div>
  </div>
</section>
