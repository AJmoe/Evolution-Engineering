    <ellipse cx="200" cy="246" rx="190" ry="34" fill="#9CC46A" opacity=".55"/>
    <ellipse cx="200" cy="244" rx="130" ry="14" fill="#0B2A4A" opacity=".08"/>
    {% if t == 'gable' %}
