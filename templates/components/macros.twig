    {% else %}
      <path d="M60 236v-78h120v78zM220 236v-78h120v78z" fill="#FFFFFF" stroke="#0B2A4A" stroke-width="1.5"/>
      <path d="M52 158h136v-10H52zM212 158h136v-10H212z" fill="#D3DFEA" stroke="#0B2A4A" stroke-width="1.5"/>
      <path d="M180 236v-60h40v60" fill="#F4F8FB" stroke="#0B2A4A" stroke-width="1.2"/>
