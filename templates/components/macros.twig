{# Shared UI macros. #}

{% macro brand(variant) %}
  <a class="bx-logo" href="/" aria-label="Evolution Engineers, home">
    <img src="/images/brand/{{ variant == 'dark' ? 'logo' : 'logo-light' }}.png" alt="Evolution Engineers" width="729" height="307">
  </a>
{% endmacro %}

{% macro page_header(title, intro, crumbs, bg) %}
  <header class="page-banner">
    <div class="page-banner__bg">{{ _self.photo(bg ?: 'building-glass', '', '100vw', true, false) }}</div>
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container">
      <h1>{{ title }}</h1>
      {% if crumbs %}
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {% for c in crumbs %}
              <li>{% if c.href is defined and not loop.last %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>
            {% endfor %}
          </ol>
        </nav>
      {% endif %}
      {% if intro %}<p class="page-banner__intro">{{ intro }}</p>{% endif %}
    </div>
  </header>
{% endmacro %}

{% macro breadcrumb_jsonld(crumbs, base_url, nonce) %}
  {% set items = [{ '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': base_url ~ '/' }] %}
  {% for c in crumbs %}
    {% set items = items|merge([{ '@type': 'ListItem', 'position': loop.index + 1, 'name': c.label, 'item': base_url ~ (c.href ?? '') }]) %}
  {% endfor %}
  <script type="application/ld+json" nonce="{{ nonce }}">{{ { '@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': items }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endmacro %}

{# Blueprint drawing used in place of project photography until real photos arrive. #}
{% macro drawing(category) %}
  <div class="drawing" data-placeholder="project-photo">
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <g stroke="#D3DFEA" stroke-width="0.8">
        {% for x in range(0, 400, 25) %}<path d="M{{ x }} 0v300"/>{% endfor %}
        {% for y in range(0, 300, 25) %}<path d="M0 {{ y }}h400"/>{% endfor %}
      </g>
      {% if category == 'roads' %}
        <path d="M60 300L180 90M340 300L220 90M200 300v-26M200 250v-26M200 202v-24M200 158v-20M200 124v-16M200 100v-10"/>
        <path d="M150 90h100" stroke-dasharray="3 5"/>
        <path d="M40 300l14-24M360 300l-14-24"/>
        <path d="M60 60h280M60 54v12M340 54v12" stroke-width="0.9"/>
      {% elseif category == 'design_build' %}
        <path d="M20 200C110 200 120 140 200 140S300 90 380 90"/>
        <path d="M20 214C110 214 120 154 200 154S300 104 380 104"/>
        <circle cx="300" cy="230" r="40"/><circle cx="300" cy="230" r="30"/>
        <path d="M250 230h-30M350 230h30M300 180v-12" stroke-dasharray="3 5"/>
        <path d="M60 250h120M60 244v12M180 244v12" stroke-width="0.9"/>
      {% elseif category == 'civil_building' %}
        <path d="M80 260V110h240v150M80 110l120-50 120 50"/>
        <path d="M110 140h40v40h-40zM180 140h40v40h-40zM250 140h40v40h-40zM180 210h40v50h-40z"/>
        <path d="M60 280h280M60 274v12M340 274v12" stroke-width="0.9"/>
        <path d="M350 110v150M344 110h12M344 260h12" stroke-width="0.9"/>
      {% elseif category == 'water_sewerage' %}
        <circle cx="140" cy="160" r="70"/><circle cx="140" cy="160" r="56"/>
        <path d="M60 160h-30M220 160h150M140 80V60" stroke-dasharray="3 5"/>
        <path d="M250 120h120v80H250z"/><path d="M250 150h120" stroke-dasharray="6 4"/>
        <path d="M70 260h140M70 254v12M210 254v12" stroke-width="0.9"/>
      {% else %}
        <path d="M60 240h280M80 240V140l60-40h120l60 40v100"/>
        <path d="M80 140h240M140 100v140M260 100v140M140 140l60 100 60-100"/>
        <circle cx="200" cy="80" r="22"/><path d="M200 50v-10M200 110v10M170 80h-10M230 80h10"/>
        <path d="M60 270h280M60 264v12M340 264v12" stroke-width="0.9"/>
      {% endif %}
    </svg>
  </div>
{% endmacro %}

{% macro machine_media(m) %}
  {% set key = m.image_path starts with 'stock/' ? m.image_path|slice(6) : null %}
  {% if key and photo_meta(key) %}
    <div class="machine__media machine__media--photo">{{ _self.photo(key, 'A ' ~ m.role|lower ~ ' machine of the same type as the ' ~ m.make ~ ' ' ~ m.model, '(min-width: 900px) 300px, 70vw', false, true) }}</div>
  {% else %}
    <div class="machine__media" data-placeholder="plant-photo">{{ _self.machine(m.group_name) }}</div>
  {% endif %}
{% endmacro %}

{% macro machine(group) %}
  <svg viewBox="0 0 200 120" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
    {% if group == 'compaction' %}
      <circle cx="50" cy="88" r="24"/><circle cx="152" cy="94" r="18"/>
      <path d="M50 64h40l10-30h40l10 30v42M76 64v-14h28"/><path d="M26 106h150"/>
    {% elseif group == 'haulage' or group == 'vehicles' %}
      <path d="M14 88V44h96v44M110 88V58h42l26 22v8z"/><circle cx="46" cy="94" r="12"/><circle cx="150" cy="94" r="12"/>
      <path d="M122 62h24l16 16h-40z"/>
    {% else %}
      <path d="M20 96h110M30 96V72h70v24M60 72V54h26v18"/><circle cx="40" cy="98" r="10"/><circle cx="92" cy="98" r="10"/>
      <path d="M100 66l40-40 34 22-8 30h-22"/><path d="M144 78l-6 14h26z"/>
    {% endif %}
  </svg>
{% endmacro %}

{% macro home_card(h) %}
  <article class="card">
    <div class="card__media"><img src="/images/homes/{{ h.slug }}-3d-sm.webp" width="600" height="450" alt="Rendered view of {{ h.name }}" loading="lazy"></div>
    <div class="card__body">
      <span class="tag">Concept design</span>
      <h3 class="card__title"><a href="/small-homes/{{ h.slug }}">{{ h.name }}</a></h3>
      <p class="card__meta"><span>{{ h.bedrooms }} bed</span><span>{{ h.bathrooms }} bath</span><span>{{ h.area_m2 }} m² {{ h.outdoor_label }}</span></p>
    </div>
  </article>
{% endmacro %}

{#
  Responsive photo. key is an interim stock key (public/images/stock) until the admin image pipeline
  serves the client's own photos. Interim photos are marked so they can be found and replaced.
#}
{% macro photo(key, alt, sizes, eager, tag) %}
  {% set m = photo_meta(key) %}
  {% if m %}
    {% set base = '/images/stock/' ~ m.key %}
    {% set largest = m.widths|last %}
    <picture class="photo" data-placeholder="stock-photo">
      <source type="image/avif" srcset="{% for w in m.widths %}{{ base }}-{{ w }}.avif {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
      <source type="image/webp" srcset="{% for w in m.widths %}{{ base }}-{{ w }}.webp {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="{{ sizes }}">
      <img src="{{ base }}-{{ m.widths[1] ?? largest }}.webp" alt="{{ alt }}" width="{{ m.width }}" height="{{ m.height }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
    </picture>
    {% if tag %}<span class="photo-tag">Illustrative photo</span>{% endif %}
  {% endif %}
{% endmacro %}

{# Key and alt text for each project's interim photo. Removed once real photography is uploaded. #}
{% macro project_media(p, sizes, eager) %}
  {% if p.photo_key and photo_meta(p.photo_key) %}
    {{ _self.photo(p.photo_key, p.photo_alt, sizes, eager, true) }}
  {% else %}
    {{ _self.drawing(p.category) }}
  {% endif %}
{% endmacro %}

{# Photo tile with a hover overlay (the theme's project card). Carries filter data for the projects page. #}
{% macro project_tile(p, hidden) %}
  <article class="tile tile--card" data-category="{{ p.category }}" data-year="{{ p.year }}"{% if hidden %} hidden{% endif %}>
    {{ _self.project_media(p, '(min-width: 1100px) 33vw, (min-width: 560px) 50vw, 100vw', false) }}
    <div class="tile__overlay">
      <p>{{ p.category_label }} &middot; {{ p.year_label }}</p>
      <h3><a href="/projects/{{ p.slug }}">{{ p.title }}</a></h3>
      <p class="tile__client">{{ p.client_name }}</p>
    </div>
  </article>
{% endmacro %}

{#
  Slideshow for one concept home: the 3D model, the floor plan and the blueprint elevations.
  Without JavaScript all three slides show one after another; with it, the thumbnails switch slides.
  Drawings come from tools/home-drawings.mjs and stills from tools/home-stills.mjs.
#}
{% macro home_gallery(h, eager) %}
  {% set base = '/images/homes/' ~ h.slug %}
  {% set plan = svg_size(base ~ '-plan.svg') %}
  {% set bp = svg_size(base ~ '-blueprint.svg') %}
  <div class="home-gallery" data-gallery>
    <div class="home-gallery__stage">
      <figure class="gslide is-active" data-slide id="slide-{{ h.slug }}-3d">
        <div class="viewer-frame" data-home-viewer data-models="{{ {(h.slug): {name: h.name, params: h.model_params}}|json_encode }}" data-initial="{{ h.slug }}">
          <img class="viewer-poster" src="{{ base }}-3d.webp" width="1200" height="900" alt="Rendered view of {{ h.name }}, a concept design" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          <span class="tag">Concept design</span>
          <div class="mood-toggle" role="group" aria-label="Lighting" data-mood-toggle hidden>
            <button type="button" data-mood="day" aria-pressed="true">Day</button>
            <button type="button" data-mood="evening" aria-pressed="false">Evening</button>
          </div>
        </div>
        <figcaption>3D model. Drag to turn it.</figcaption>
      </figure>
      <figure class="gslide" data-slide id="slide-{{ h.slug }}-plan">
        <a class="drawing-frame" href="{{ base }}-plan.svg" target="_blank" rel="noopener"><img src="{{ base }}-plan.svg"{% if plan %} width="{{ plan.width }}" height="{{ plan.height }}"{% endif %} alt="Floor plan of {{ h.name }}: room layout with furniture and dimensions" loading="lazy"></a>
        <figcaption>Floor plan. Open it full size for detail.</figcaption>
      </figure>
      <figure class="gslide" data-slide id="slide-{{ h.slug }}-blueprint">
        <a class="drawing-frame drawing-frame--blue" href="{{ base }}-blueprint.svg" target="_blank" rel="noopener"><img src="{{ base }}-blueprint.svg"{% if bp %} width="{{ bp.width }}" height="{{ bp.height }}"{% endif %} alt="Blueprint of {{ h.name }}: front and side elevations with heights" loading="lazy"></a>
        <figcaption>Blueprint: front and side elevations.</figcaption>
      </figure>
      <button class="round-btn gallery-prev" type="button" data-gallery-prev aria-label="Previous view" hidden><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button class="round-btn gallery-next" type="button" data-gallery-next aria-label="Next view" hidden><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
    <div class="home-gallery__thumbs" role="group" aria-label="Views of {{ h.name }}" hidden>
      <button type="button" data-thumb="0" aria-pressed="true" aria-controls="slide-{{ h.slug }}-3d"><img src="{{ base }}-3d-sm.webp" alt="" width="600" height="450" loading="lazy"><span>3D model</span></button>
      <button type="button" data-thumb="1" aria-pressed="false" aria-controls="slide-{{ h.slug }}-plan"><img src="{{ base }}-plan.svg" alt=""{% if plan %} width="{{ plan.width }}" height="{{ plan.height }}"{% endif %} loading="lazy"><span>Floor plan</span></button>
      <button type="button" data-thumb="2" aria-pressed="false" aria-controls="slide-{{ h.slug }}-blueprint"><img src="{{ base }}-blueprint.svg" alt=""{% if bp %} width="{{ bp.width }}" height="{{ bp.height }}"{% endif %} loading="lazy"><span>Blueprint</span></button>
    </div>
  </div>
{% endmacro %}
