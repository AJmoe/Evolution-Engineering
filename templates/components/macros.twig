{# Indicative floor plan drawn from the design type. TODO-CLIENT: replace with the designer's SVG plans. #}
{% macro floorplan(home) %}
  {% set t = home.model_params.type ?? 'gable' %}
  <figure class="floorplan" data-placeholder="floor-plan">
    <svg viewBox="0 0 320 220" role="img" aria-labelledby="fp-{{ home.slug }}" fill="none" stroke="currentColor" stroke-width="3" font-family="Hanken Grotesk, sans-serif" font-size="10">
      <title id="fp-{{ home.slug }}">Indicative floor plan of {{ home.name }}: {{ home.bedrooms }} bedroom{{ home.bedrooms > 1 ? 's' }}, {{ home.bathrooms }} bathroom{{ home.bathrooms > 1 ? 's' }}, {{ home.area_m2 }} m²</title>
      {% if t == 'gable' %}
        <rect x="60" y="30" width="200" height="130"/><path d="M160 30v80M160 110h100M210 110v50" stroke-width="2"/>
        <rect x="60" y="160" width="200" height="40" stroke-dasharray="5 4" stroke-width="1.5"/>
        <g fill="currentColor" stroke="none"><text x="80" y="80">Living and kitchen</text><text x="178" y="72">Bedroom</text><text x="168" y="140">Bath</text><text x="220" y="140">Store</text><text x="130" y="184">Veranda</text></g>
      {% elseif t == 'lshape' %}
        <path d="M30 30h170v90h90v80H30z"/><path d="M200 30v90M110 30v90M30 120h170M200 120v80M120 120v80" stroke-width="2"/>
        <rect x="200" y="30" width="90" height="90" stroke-dasharray="5 4" stroke-width="1.5"/>
        <g fill="currentColor" stroke="none"><text x="44" y="80">Bedroom 1</text><text x="124" y="80">Bedroom 2</text><text x="54" y="164">Bath</text><text x="140" y="164">Kitchen</text><text x="224" y="164">Living</text><text x="222" y="80">Veranda</text></g>
      {% else %}
        <path d="M20 20h280v180H20z"/><rect x="110" y="70" width="100" height="80" stroke-dasharray="5 4" stroke-width="1.5"/>
        <path d="M110 20v50M210 20v50M110 150v50M210 150v50M20 110h90M210 110h90" stroke-width="2"/>
        <g fill="currentColor" stroke="none"><text x="34" y="60">Bedroom 1</text><text x="130" y="48">Living</text><text x="226" y="60">Bedroom 2</text><text x="134" y="114">Courtyard</text><text x="34" y="160">Kitchen</text><text x="130" y="180">Bath</text><text x="226" y="160">Bedroom 3</text></g>
      {% endif %}
    </svg>
    <figcaption class="small muted">Indicative plan. Final drawings are prepared for each plot.</figcaption>
  </figure>
{% endmacro %}

{% macro home_card(h) %}
  <article class="card">
    <div class="card__media">{{ _self.home_poster(h) }}</div>
    <div class="card__body">
      <span class="tag">Concept design</span>
      <h3 class="card__title"><a href="/small-homes/{{ h.slug }}">{{ h.name }}</a></h3>
      <p class="card__meta"><span>{{ h.bedrooms }} bed</span><span>{{ h.bathrooms }} bath</span><span>{{ h.area_m2 }} m² {{ h.outdoor_label }}</span></p>
    </div>
  </article>
{% endmacro %}

