{
  "name": "evolution-engineers/website",
  "description": "Evolution Engineers corporate website",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "slim/twig-view": "^3.4",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9",
    "monolog/monolog": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": { "psr-4": { "EvolutionEngineers\\": "src/" } },
  "autoload-dev": { "psr-4": { "EvolutionEngineers\\Tests\\": "tests/" } },
  "scripts": {
    "serve": "php -S localhost:8080 -t public public/index.php",
    "migrate": "php database/migrate.php",
    "test": "phpunit",
    "lint": "phpcs",
    "stan": "phpstan analyse"
  },
  "config": { "sort-packages": true, "platform-check": false }
}
