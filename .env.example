APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Set to true on staging so search engines do not index it
APP_NOINDEX=true
# Random secret used to hash IP addresses on enquiries
APP_SECRET=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=evolution_engineers
DB_USER=root
DB_PASS=

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=
MAIL_FROM=website@evolutionengineers.co.bw
MAIL_FROM_NAME="Evolution Engineers website"

# Vite dev server. Leave empty to use built assets from public/assets
VITE_DEV_SERVER=

# Set to true only behind a reverse proxy (Render, a load balancer) so rate limits see the real visitor IP
TRUST_PROXY=false
